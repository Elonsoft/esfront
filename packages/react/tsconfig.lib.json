{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "lib",
    "rootDir": "src"
  },
  "exclude": [
    "node_modules",
    "storybook-static",
    "lib",
    "scripts",
    "./*.js",
    "./*.ts",
    "src/documentation",
    "src/testing",
    "src/**/*.spec.tsx",
    "src/**/*.stories.tsx"
  ]
}
